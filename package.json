{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "check": "node tools/check-site.mjs",
    "verify": "hexo stellar doctor && hexo clean && hexo generate && node tools/check-site.mjs",
    "build:domain": "hexo generate --config _config.yml,_config.domain.yml",
    "verify:domain": "hexo stellar doctor --config _config.yml,_config.domain.yml && hexo clean --config _config.yml,_config.domain.yml && hexo generate --config _config.yml,_config.domain.yml && node tools/check-site.mjs _config.domain.yml",
    "server:domain": "hexo server --config _config.yml,_config.domain.yml --port 4001",
    "seo:ping": "node tools/ping-search.mjs _config.domain.yml",
    "seo:ping:dry": "node tools/ping-search.mjs _config.domain.yml --dry-run",
    "cert:check": "node tools/ssl-renew.mjs --check",
    "cert:renew": "node tools/ssl-renew.mjs",
    "favicon": "node tools/make-favicon.mjs",
    "images:compress": "node tools/optimize-images.mjs --write",
    "images:report": "node tools/optimize-images.mjs",
    "browser:a11y": "node tools/browser-check.mjs / /posts/ /examples/ /about/",
    "browser:a11y:dark": "node tools/browser-check.mjs --dark / /posts/ /examples/ /about/",
    "deploy:domain": "bun run verify:domain && bunx wrangler@4.151.0 pages deploy public-domain --project-name guangluo-blog --branch main --commit-dirty=true"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-stellar": "2.0.0"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "esbuild": "0.28.2",
    "exifr": "^7.1.3",
    "js-yaml": "^4.3.2",
    "sharp": "^0.35.5",
    "tencentcloud-sdk-nodejs-dnspod": "4.1.266",
    "tencentcloud-sdk-nodejs-ssl": "4.1.281",
    "vanilla-lazyload": "19.1.3"
  }
}
